#include <stdio.h>
#include <unistd.h>
#include "system.h"
#include "altera_avalon_pio_regs.h"
#include "altera_avalon_timer_regs.h"
#include "sys/alt_irq.h"

volatile int hours = 0;
volatile int minutes = 0;
volatile int seconds = 0;
volatile int is_editing = 0; // 0 = Đang chạy, 1 = Đang dừng (chỉnh sửa)

// --- HÀM NGẮT TIMER ---
void timer_isr(void* context) {
    IOWR_ALTERA_AVALON_TIMER_STATUS(TIMER_0_BASE, 0);

    // Chỉ tự động đếm khi KHÔNG ở chế độ chỉnh sửa (SW0 gạt lên)
    if (!is_editing) {
        seconds++;
        if (seconds >= 60) {
            seconds = 0;
            minutes++;
            if (minutes >= 60) {
                minutes = 0;
                hours++;
                if (hours >= 24) {
                    hours = 0;
                }
            }
        }
    }
}

// --- HÀM HIỂN THỊ LED ---
void display_time() {
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_0_BASE, seconds % 10);
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_1_BASE, seconds / 10);
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_2_BASE, minutes % 10);
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_3_BASE, minutes / 10);
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_4_BASE, hours % 10);
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_5_BASE, hours / 10);
}

int main() {
    printf("Clock System Started. SW0 controls Run/Stop.\n");

    IOWR_ALTERA_AVALON_TIMER_PERIODL(TIMER_0_BASE, 0x2480);
    IOWR_ALTERA_AVALON_TIMER_PERIODH(TIMER_0_BASE, 0x02FA);
    alt_ic_isr_register(0, TIMER_0_IRQ, timer_isr, NULL, NULL);
    IOWR_ALTERA_AVALON_TIMER_CONTROL(TIMER_0_BASE, 0x07);

    int last_key_state = 1;

    while (1) {
        int sw_state = IORD_ALTERA_AVALON_PIO_DATA(SWITCHES_0_BASE);
        int key_state = IORD_ALTERA_AVALON_PIO_DATA(KEYS_0_BASE);

        // Kiểm tra SW0 (bit 0): Gạt lên (1) là CHẠY, Gạt xuống (0) là DỪNG
        if (sw_state & 0x01) {
            is_editing = 0; // Đồng hồ chạy bình thường
        }
        else {
            is_editing = 1; // Đồng hồ DỪNG để chờ chỉnh sửa

            // Logic bắt sườn xuống cho KEY1
            if (((key_state & 0x01) == 0) && (last_key_state == 1)) {

                if (sw_state & 0x02) { // SW1 gạt lên -> Tăng Giây
                    seconds++;
                    if (seconds >= 60) seconds = 0;
                }
                if (sw_state & 0x04) { // SW2 gạt lên -> Tăng Phút
                    minutes++;
                    if (minutes >= 60) minutes = 0;
                }
                if (sw_state & 0x08) { // SW3 gạt lên -> Tăng Giờ
                    hours++;
                    if (hours >= 24) hours = 0;
                }
            }
        }

        display_time(); // Hàm này nằm ngoài cùng, nên số mới sẽ hiện ra LED NGAY LẬP TỨC khi bấm phím
        last_key_state = (key_state & 0x01);
        usleep(10000);
    }
    return 0;
}
