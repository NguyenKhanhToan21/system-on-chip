#include <stdio.h>
#include <unistd.h>
#include "system.h"
#include "altera_avalon_pio_regs.h"
#include "altera_avalon_timer_regs.h"
#include "sys/alt_irq.h"

volatile int hours = 0;
volatile int minutes = 0;
volatile int seconds = 0;
volatile int is_editing = 0;

// --- HÀM NGẮT TIMER ---
void timer_isr(void* context) {
    IOWR_ALTERA_AVALON_TIMER_STATUS(TIMER_0_BASE, 0);
    if (!is_editing) {
        seconds++;
        if (seconds >= 60) {
            seconds = 0;
            minutes++;
            if (minutes >= 60) {
                minutes = 0;
                hours++;
                if (hours >= 24) hours = 0;
            }
        }
    }
}

// --- HÀM HIỂN THỊ ĐÚNG THEO YÊU CẦU CỦA BẠN ---
void display_time() {
    // HEX 1, 0: Giây
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_0_BASE, seconds % 10); // HEX0 = Ones của Giây
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_1_BASE, seconds / 10); // HEX1 = Tens của Giây

    // HEX 3, 2: Phút
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_2_BASE, minutes % 10); // HEX2 = Ones của Phút
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_3_BASE, minutes / 10); // HEX3 = Tens của Phút

    // HEX 5, 4: Giờ
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_4_BASE, hours % 10);   // HEX4 = Ones của Giờ
    IOWR_ALTERA_AVALON_PIO_DATA(PIO_5_BASE, hours / 10);   // HEX5 = Tens của Giờ
}

int main() {
    printf("Clock System Started.\n");

    IOWR_ALTERA_AVALON_TIMER_PERIODL(TIMER_0_BASE, 0x2480);
    IOWR_ALTERA_AVALON_TIMER_PERIODH(TIMER_0_BASE, 0x02FA);
    alt_ic_isr_register(0, TIMER_0_IRQ, timer_isr, NULL, NULL);
    IOWR_ALTERA_AVALON_TIMER_CONTROL(TIMER_0_BASE, 0x07);

    int last_key_state = 1;

    while (1) {
        int sw_state = IORD_ALTERA_AVALON_PIO_DATA(SWITCHES_0_BASE);
        int key_state = IORD_ALTERA_AVALON_PIO_DATA(PIO_6_BASE);

        // TÁCH RỜI TỪNG SWITCH: Giả sử gạt lên là 1 (Bật)
        // Nếu board của bạn bị NGƯỢC (gạt xuống mới là Bật), hãy sửa (sw_state & 0x...) ? 1 : 0 thành ? 0 : 1
        int sw0_on = (sw_state & 0x01) ? 1 : 0;
        int sw1_on = (sw_state & 0x02) ? 1 : 0;
        int sw2_on = (sw_state & 0x04) ? 1 : 0;
        int sw3_on = (sw_state & 0x08) ? 1 : 0;

        // Xử lý SW0 (Công tắc tổng)
        if (sw0_on) {
            is_editing = 0; // SW0 bật -> Chạy bình thường
        }
        else {
            is_editing = 1; // SW0 tắt -> Dừng đồng hồ

            // Bắt sườn xuống của nút nhấn KEY1
            if (((key_state & 0x01) == 0) && (last_key_state == 1)) {

                // Nếu SW1 bật -> +1 Giây
                if (sw1_on) {
                    seconds++;
                    if (seconds >= 60) seconds = 0;
                }

                // Nếu SW2 bật -> +1 Phút (Độc lập với Giây)
                if (sw2_on) {
                    minutes++;
                    if (minutes >= 60) minutes = 0;
                }

                // Nếu SW3 bật -> +1 Giờ (Độc lập với Phút, Giây)
                if (sw3_on) {
                    hours++;
                    if (hours >= 24) hours = 0;
                }
            }
        }

        display_time(); // Xuất ra LED
        last_key_state = (key_state & 0x01);
        usleep(10000);
    }
    return 0;
}
